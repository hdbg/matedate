# Copy to .env.local and fill from `supabase status`. Dev connects to the
# local Supabase CLI instance.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Solo PvE game backend (FastAPI WebSocket, see backend/). The Match screen connects here.
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000/ws
# Ranked PvP socket (same backend, second endpoint). The PvP match screen connects here.
NEXT_PUBLIC_BACKEND_WS_MATCH_URL=ws://127.0.0.1:8000/ws/match
