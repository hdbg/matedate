# Provider-agnostic LLM via OpenRouter. Leave OPENROUTER_API_KEY empty to fall back to the
# deterministic FAKE_ENGINE (useful for offline dev/tests); set it to use the real model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

SOLO_MOVE_SECONDS=30
SOLO_MAX_EXCHANGES=6

# When true (or when OPENROUTER_API_KEY is empty) the backend uses a local heuristic engine.
FAKE_ENGINE=false
