# Copy to .env and fill from `supabase status` + your OpenRouter account.

# Local Supabase CLI instance.
SUPABASE_URL=http://127.0.0.1:54321
# SERVICE-ROLE key (from `supabase status`). Bypasses RLS — the backend is the sole writer
# of game state. Never expose this to the client / commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Provider-agnostic LLM access via OpenRouter (no vendor lock-in).
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Solo PvE tuning. Per-game Fischer clock: start with SOLO_BASE_SECONDS, gain
# SOLO_INCREMENT_SECONDS back after each submitted move.
SOLO_BASE_SECONDS=30
SOLO_INCREMENT_SECONDS=5
SOLO_MAX_EXCHANGES=6

# Post-game deep analysis (game_analysis worker). Runs on a stronger model than live play,
# still via OPENROUTER_API_KEY above. VISIBILITY_TIMEOUT must exceed the model's worst-case
# latency. FAKE_ENGINE / an empty OPENROUTER_API_KEY runs the deterministic fake analysis engine.
ANALYSIS_MODEL=anthropic/claude-opus-4.1
ANALYSIS_VISIBILITY_TIMEOUT_SECONDS=300
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_POLL_SECONDS=2

# Dev/test only: skip the real LLM and use a deterministic heuristic engine so the full
# WebSocket flow (live play AND analysis) runs without an OpenRouter key. Leave false in real use.
FAKE_ENGINE=false
